SPRINT_FOLDER=sprint5-with-bugs

# Application Settings
BASE_URL=http://localhost:4200
TEST_ENV=local

# Test Execution Settings
TEST_TIMEOUT=5000
TEST_RETRIES=0
HEADLESS=true
SLOW_MO=0

# Test Selection (comma-separated test IDs)
# Leave empty to run all tests
CONTACT_TEST_CASES=
CHECKOUT_TEST_CASES="TC_ADDRESS_001,TC_ADDRESS_002,TC_ADDRESS_003,TC_ADDRESS_004"

# Authentication (for logged-in user tests)
TEST_USERNAME=customer@practicesoftwaretesting.com
TEST_PASSWORD=welcome01

# Reporting Settings
SCREENSHOTS=true
VIDEO=false
TRACE=false

# Browser Settings
DEFAULT_BROWSER=chromium

# Advanced Settings
PARALLEL_WORKERS=1
CI=false