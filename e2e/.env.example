# Contact Form Test Configuration
# Copy this file to .env and update values as needed

# Application Settings
BASE_URL=http://localhost:4200
TEST_ENV=local

# Test Execution Settings
TEST_TIMEOUT=30000
TEST_RETRIES=0
HEADLESS=true
SLOW_MO=0

# Test Selection (comma-separated test IDs)
# Leave empty to run all tests
CONTACT_TEST_CASES=
CHECKOUT_TEST_CASES=

# Authentication (for logged-in user tests)
TEST_USERNAME=customer@practicesoftwaretesting.com
TEST_PASSWORD=welcome01

# Reporting Settings
SCREENSHOTS=true
VIDEO=false
TRACE=false

# Cleanup Settings
CLEANUP_OLD_ARTIFACTS=false

# Browser Settings
DEFAULT_BROWSER=chromium

# Advanced Settings
PARALLEL_WORKERS=4
CI=false